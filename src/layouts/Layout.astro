---
import '../styles/styles.scss';

interface Props {
  title: string;
  description?: string;
  bodyId?: string;
  bodyClass?: string;
}

const { title, description, bodyId, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta content="initial-scale=1,maximum-scale=2,width=device-width" name="viewport" />
    {description && <meta name="Description" content={description} />}
    <title>{title}</title>
    <meta name="theme-color" content="#333333" />

    <link rel="icon" href="/assets/favicon/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/assets/favicon/favicon-128.png" sizes="128x128" />
    <link rel="icon" href="/assets/favicon/favicon-192.png" sizes="192x192" />
    <link rel="shortcut icon" sizes="196x196" href="/assets/favicon/favicon-196.png" />
    <link rel="apple-touch-icon" href="/assets/favicon/favicon-120.png" sizes="120x120" />
    <link rel="apple-touch-icon" href="/assets/favicon/favicon-152.png" sizes="152x152" />
    <link rel="apple-touch-icon" href="/assets/favicon/favicon-180.png" sizes="180x180" />
  </head>
  <body id={bodyId} class={bodyClass}>
    <slot />
  </body>
</html>
